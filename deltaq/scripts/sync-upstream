#!/usr/bin/env bash
# Merge upstream zed-industries/zed main into a new branch off `gpui` and
# resolve everything that is mechanical:
#
#   1. paths outside deltaq/keep.txt        -> removed (covers modify/delete conflicts)
#   2. README.md, .rules and symlinks       -> ours
#   3. Cargo.toml / Cargo.lock              -> upstream's, filtered to present crates
#   4. files of changes Zed already merged  -> upstream's (same diff, squash-merged)
#
# Anything still conflicted is a real conflict in a kept crate and is left for
# a human. The script exits 2 in that case, with the merge in progress and the
# conflicted files listed. Resolve them, `git add` them, then run
#
#   deltaq/scripts/sync-upstream --continue
#
# which regenerates Cargo.toml and Cargo.lock and commits the merge.

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$ROOT"

conflicts_file="$(git rev-parse --path-format=absolute --git-path deltaq-sync-conflicts)"

finish() {
    # Regenerating runs cargo, which parses every kept crate's manifest, so it
    # can only run once no conflict markers are left in any of them.
    local upstream_manifest upstream_sha
    upstream_manifest="$(mktemp)"
    git show MERGE_HEAD:Cargo.toml > "$upstream_manifest"
    git show MERGE_HEAD:Cargo.lock > Cargo.lock
    # A child shell, so a cargo failure can print what usually causes it; in an
    # `||` list this shell's own `set -e` would not stop on it.
    bash -c 'source "$1/deltaq/scripts/lib.sh" && regenerate_workspace "$2"' _ "$ROOT" "$upstream_manifest" || {
        echo "error: cargo could not load the workspace (often a kept crate depends on" >&2
        echo "one deltaq/keep.txt strips). Fix it, git add, then rerun with --continue." >&2
        rm -f "$upstream_manifest"
        exit 1
    }
    rm -f "$upstream_manifest"
    git add Cargo.toml Cargo.lock

    upstream_sha="$(git rev-parse --short MERGE_HEAD)"
    git commit -q -m "Sync upstream zed@${upstream_sha}" -m "Merged ${UPSTREAM_URL}/commit/$(git rev-parse MERGE_HEAD)"
    rm -f "$conflicts_file"
    echo "created $(git rev-parse --abbrev-ref HEAD); open a PR against $MAIN_BRANCH"
}

if [[ "${1:-}" == "--continue" ]]; then
    if [[ "$(git rev-parse --abbrev-ref HEAD)" != sync/upstream-* ]] \
        || ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
        echo "error: no sync-upstream merge in progress on a sync/upstream-* branch" >&2
        exit 1
    fi
    unmerged="$(git diff --name-only --diff-filter=U)"
    if [[ -n "$unmerged" ]]; then
        echo "error: still unmerged; resolve and git add:" >&2
        echo "$unmerged" >&2
        exit 2
    fi
    if [[ -f "$conflicts_file" ]]; then
        leftover=()
        while IFS= read -r path; do
            if [[ -f "$path" ]] && grep -q -E '^(<<<<<<<|>>>>>>>)( |$)' "$path"; then
                leftover+=("$path")
            fi
        done < "$conflicts_file"
        if (( ${#leftover[@]} )); then
            echo "error: conflict markers left in:" >&2
            printf '%s\n' "${leftover[@]}" >&2
            exit 2
        fi
    fi
    # Cargo.toml and Cargo.lock are rewritten by finish(), also after a failed try
    if ! git diff --quiet -- . ':!Cargo.toml' ':!Cargo.lock'; then
        echo "error: unstaged edits; git add the resolution first:" >&2
        git diff --name-only -- . ':!Cargo.toml' ':!Cargo.lock' >&2
        exit 1
    fi
    finish
    exit 0
fi

require_clean_tree
ensure_upstream_remote
git fetch upstream main

upstream_sha="$(git rev-parse --short upstream/main)"
branch="sync/upstream-${upstream_sha}"
if git rev-parse --verify --quiet "$branch" >/dev/null; then
    echo "error: branch $branch already exists" >&2
    exit 1
fi
if git merge-base --is-ancestor upstream/main "$MAIN_BRANCH"; then
    echo "already up to date with upstream/main ($upstream_sha)"
    exit 0
fi

git checkout -q -b "$branch" "$MAIN_BRANCH"
git merge --no-commit --no-ff upstream/main >/dev/null 2>&1 || true
if ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    echo "error: git merge upstream/main did not start; run it by hand to see why" >&2
    exit 1
fi

# 1. strip paths we do not keep, including anything upstream added since
deltaq/scripts/strip

# 2. files this fork owns outright
for owned in README.md .rules CLAUDE.md AGENTS.md; do
    git checkout "$MAIN_BRANCH" -- "$owned"
done

# 3. root manifest and lockfile: upstream's, filtered. This pass needs no cargo,
# so they never count as conflicts; finish() regenerates both properly.
upstream_manifest="$(mktemp)"
git show MERGE_HEAD:Cargo.toml > "$upstream_manifest"
git show MERGE_HEAD:Cargo.lock > Cargo.lock
deltaq/scripts/filter-workspace "$upstream_manifest" > Cargo.toml
rm -f "$upstream_manifest"
git add Cargo.toml Cargo.lock

# 4. changes Zed merged since the last sync: upstream wins on their files
deltaq/scripts/track-changes --resolve-merged

remaining="$(git diff --name-only --diff-filter=U)"
if [[ -n "$remaining" ]]; then
    printf '%s\n' "$remaining" > "$conflicts_file"
    echo "manual conflicts remain in kept crates:" >&2
    echo "$remaining" >&2
    echo "resolve them, git add them, then: deltaq/scripts/sync-upstream --continue" >&2
    exit 2
fi

finish
