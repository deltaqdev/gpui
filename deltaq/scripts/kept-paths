#!/usr/bin/env python3
"""Filter stdin paths down to those covered by deltaq/keep.txt."""
import importlib.machinery
import importlib.util
import os
import sys

here = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_loader(
    "strip", importlib.machinery.SourceFileLoader("strip", os.path.join(here, "strip"))
)
strip = importlib.util.module_from_spec(spec)
spec.loader.exec_module(strip)

prefixes = strip.load_keep()
for line in sys.stdin:
    path = line.strip()
    if path and strip.is_kept(path, prefixes):
        print(path)
